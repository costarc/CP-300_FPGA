# CP-300 FPGA - Terasic DE0 (Cyclone III EP3C16F484C6), Quartus II 13.0sp1
set_global_assignment -name FAMILY "Cyclone III"
set_global_assignment -name DEVICE EP3C16F484C6
set_global_assignment -name TOP_LEVEL_ENTITY cp300_de0
set_global_assignment -name ORIGINAL_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED WITH WEAK PULL-UP"
set_global_assignment -name CYCLONEII_RESERVE_NCEO_AFTER_CONFIGURATION "USE AS REGULAR IO"
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"
set_global_assignment -name OPTIMIZE_HOLD_TIMING "ALL PATHS"
set_global_assignment -name FITTER_EFFORT "STANDARD FIT"

# Sources
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/de0/cp300_de0.sv
set_global_assignment -name VHDL_FILE ../../roms/cp300_roms_pkg.vhd
set_global_assignment -name VHDL_FILE ../../rtl/cp300/cp300_rom.vhd
set_global_assignment -name VHDL_FILE ../../rtl/de0/pll_de0.vhd
set_global_assignment -name VHDL_FILE ../../rtl/io/io_fw_pkg.vhd
set_global_assignment -name VHDL_FILE ../../rtl/io/io_ctrl.vhd
set_global_assignment -name VHDL_FILE ../../rtl/ht1080z/ht1080z.vhd
set_global_assignment -name VHDL_FILE ../../rtl/ht1080z/videoctrl.vhd
set_global_assignment -name VHDL_FILE ../../rtl/ht1080z/ps2kbd.vhd
set_global_assignment -name VHDL_FILE ../../rtl/ht1080z/ps2reader.vhd
set_global_assignment -name VHDL_FILE ../../rtl/ht1080z/YM2149.vhd
set_global_assignment -name VHDL_FILE ../../rtl/ht1080z/vol_table_array.vhd
set_global_assignment -name VERILOG_FILE ../../rtl/ht1080z/sdram.v
set_global_assignment -name VERILOG_FILE ../../rtl/ht1080z/trs80_rs232.v
set_global_assignment -name VERILOG_FILE ../../rtl/ht1080z/gen_uart.v
set_global_assignment -name QIP_FILE ../../rtl/T80/T80.qip
set_global_assignment -name VERILOG_FILE ../../rtl/mist-modules/mist_video.v
set_global_assignment -name VERILOG_FILE ../../rtl/mist-modules/osd.v
set_global_assignment -name VERILOG_FILE ../../rtl/mist-modules/video_cleaner.v
set_global_assignment -name VERILOG_FILE ../../rtl/mist-modules/rgb2ypbpr.v
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/mist-modules/cofi.sv
set_global_assignment -name VHDL_FILE ../../rtl/mist-modules/dac.vhd
set_global_assignment -name QIP_FILE ../../rtl/mist-modules/scandoubler/scandoubler.qip
set_global_assignment -name SDC_FILE cp300_de0.sdc

# Pins (from the Terasic DE0 System CD, DE0_TOP.qsf)
